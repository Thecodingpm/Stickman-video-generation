{
  "name": "whiteboard-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=512 ./node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=512 ./node_modules/typescript/bin/tsc -b && node --max-old-space-size=512 ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mcp:whiteboard": "tsx mcp/server.ts",
    "test:director": "tsx scripts/testVisualDirector.ts",
    "test:longform": "tsx scripts/testLongformPlanner.ts",
    "test:chunks": "tsx scripts/testChunkRender.ts",
    "test:parallel": "tsx scripts/testParallelChunkRender.ts",
    "render:chunks": "tsx scripts/renderProjectInChunks.ts",
    "test:quality": "tsx scripts/testQualityValidator.ts"
  },
  "dependencies": {
    "fabric": "^7.3.1",
    "firebase": "^10.12.0",
    "gif.js": "^0.2.0",
    "gsap": "^3.15.0",
    "immer": "^11.1.4",
    "lodash-es": "^4.18.1",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.1",
    "uuid": "^14.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.15",
    "puppeteer": "^22.6.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
